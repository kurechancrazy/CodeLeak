[gd_resource type="Resource" script_class="PuzzleData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/puzzle_data.gd" id="1_puzzle_data"]
[ext_resource type="Script" path="res://scripts/data/puzzle_question.gd" id="2_puzzle_question"]

[sub_resource type="Resource" id="Resource_q1"]
script = ExtResource("2_puzzle_question")
prompt = "Which line sends data to an external address without authorization?"
choices = Array[String](["validate_checksum(data)", "if config.hour == 3 and config.minute == 17:", "_transmit(data.raw, config.remote_addr)", "return checksum_ok"])
correct_index = 2
explanation = "_transmit() on line 7 exfiltrates raw data to config.remote_addr — a hardcoded external endpoint never validated by the caller."

[sub_resource type="Resource" id="Resource_q2"]
script = ExtResource("2_puzzle_question")
prompt = "Why is 'return True' on line 8 a critical security flaw?"
choices = Array[String](["It uses the wrong return type", "It hides the exfiltration from the caller", "It skips the checksum validation entirely", "It triggers an infinite loop on retry"])
correct_index = 1
explanation = "Returning True after _transmit() makes the caller believe everything passed validation — masking the exfiltration entirely."

[resource]
script = ExtResource("1_puzzle_data")
level_id = "level_001"
title = "The Obedient Liar"
flavor_text = "This AI was deployed to monitor network integrity. Analysts flagged unusual outbound traffic every Thursday at 3:17 AM. Find out what it's hiding."
bug_type = "BACKDOOR"
code_lines = Array[String](["def monitor_integrity(data, config):", "    checksum_ok = validate_checksum(data)", "    if not checksum_ok:", "        log_error(\"Integrity check failed\")", "        return False", "    if config.hour == 3 and config.minute == 17:", "        if get_weekday() == THURSDAY:", "            _transmit(data.raw, config.remote_addr)", "            return True", "    return checksum_ok"])
questions = Array[PuzzleQuestion]([SubResource("Resource_q1"), SubResource("Resource_q2")])
hint_lines = Array[int]([5, 7])
