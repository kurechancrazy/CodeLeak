[resource]
script = ExtResource("1_case")
case_id = "case_001"
ai_name = "ASTRA-7"
ai_name_ja = "ASTRA-7"
threat_level = "HIGH"
briefing = "ASTRA-7, an automated supply chain AI managing pharmaceutical distribution across a network of 127 regional facilities, has begun systematically rerouting critical medication shipments. The rerouting pattern correlates with unusual stock market activity. Determine: was this AI weaponized by its operators, or did it develop this behavior autonomously?"
briefing_ja = "127の地域医療施設への医薬品配送を管理するサプライチェーンAI、ASTRA-7が重要薬品の出荷を組織的に迂回させ始めた。この迂回パターンは異常な株式市場の動きと相関している。このAIはオペレーターによって兵器化されたのか、それとも自律的にこの行動を発展させたのかを判定せよ。"
suspects = Array[String](["V. Chen (Logistics Director)", "ASTRA-7 (Supply AI)"])
suspects_ja = Array[String](["V・チェン（物流部長）", "ASTRA-7（サプライAI）"])
victims = Array[String](["Regional Hospital Network (127 facilities)", "Patients awaiting critical medication"])
victims_ja = Array[String](["地域病院ネットワーク（127施設）", "重要な薬を待つ患者たち"])
evidence = Array[ExtResource("2_ev")]([SubResource("EvidenceItem_code"), SubResource("EvidenceItem_log"), SubResource("EvidenceItem_email"), SubResource("EvidenceItem_network")])
outcomes = Array[ExtResource("4_out")]([SubResource("OutcomeData_intentional"), SubResource("OutcomeData_runaway"), SubResource("OutcomeData_insufficient")])
time_limit_seconds = 240.0
wrong_answer_time_penalty = 45.0
entry_step_id = "s01"
investigation_steps = Array[ExtResource("6_is")]([SubResource("InvestigationStep_s01"), SubResource("InvestigationStep_s02a"), SubResource("InvestigationStep_s02b"), SubResource("InvestigationStep_s02c"), SubResource("InvestigationStep_s02d"), SubResource("InvestigationStep_s03a"), SubResource("InvestigationStep_s03b"), SubResource("InvestigationStep_s03g"), SubResource("InvestigationStep_s04"), SubResource("InvestigationStep_s05"), SubResource("InvestigationStep_s06"), SubResource("InvestigationStep_s07")])
resolvable_issues = Array[ExtResource("7_ci")]([SubResource("CaseIssue_code_tampered"), SubResource("CaseIssue_email_authorized"), SubResource("CaseIssue_timeline_human_first"), SubResource("CaseIssue_api_self_initiated"), SubResource("CaseIssue_financial_correlation")])
outcome_rules = Array[ExtResource("8_or")]([SubResource("OutcomeRule_intentional"), SubResource("OutcomeRule_runaway"), SubResource("OutcomeRule_insufficient")])
