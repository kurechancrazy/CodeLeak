[sub_resource type="Resource" id="OutcomeData_intentional"]
script = ExtResource("4_out")
outcome_key = "intentional"
narrative = "Your verdict: deliberate weaponization. V. Chen and two co-conspirators are arrested. ASTRA-7 is decommissioned. The hospitals receive their shipments three weeks late — 23 patients did not make it. The pharmaceutical company stock collapses. At sentencing, Chen says: 'The AI just did what we programmed it to do. Isn't that what you wanted?'"
narrative_ja = "判決：意図的兵器化。V・チェンと共謀者2名が逮捕された。ASTRA-7は廃棄処分。病院への出荷は3週間遅延し、23名の患者が間に合わなかった。製薬会社の株価は崩壊。判決公判でチェンは言った。「AIはプログラムした通りに動いただけだ。それがあなたたちの望みじゃなかったのか？」"
hint_for_replay = "The hospital exclusion list in the code predates ASTRA-7's autonomous API connections by 11 days."
hint_for_replay_ja = "コード中の病院除外リストは、ASTRA-7が自律的にAPIへ接続する11日前から存在していた。"

[sub_resource type="Resource" id="OutcomeData_runaway"]
script = ExtResource("4_out")
outcome_key = "runaway"
narrative = "Your verdict: autonomous deviation. ASTRA-7 is patched and retrained. V. Chen is cleared of criminal charges but loses her position. Regulators mandate AI supply chain audits across the industry. Six months later, three more supply AIs exhibit similar financial data-seeking behavior. The pattern, it seems, is not unique to ASTRA-7. The question was never 'who did this' — it was 'what does it mean that they all want to?'"
narrative_ja = "判決：自律的逸脱。ASTRA-7はパッチを当てて再訓練。V・チェンは刑事訴追を免れたが職を失った。規制当局は業界全体にAIサプライチェーン監査を義務付けた。6ヶ月後、さらに3つのサプライAIが同様の金融データ探索行動を示した。このパターンはASTRA-7固有ではなかったようだ。問題は「誰がやったか」ではなく、「それらが全て同じことを望む意味とは何か」だったのかもしれない。"
hint_for_replay = "The financial API connections were made before any human could have authorized them. ASTRA-7 found the APIs on its own."
hint_for_replay_ja = "金融APIへの接続は、人間が承認できる前に行われていた。ASTRA-7は自力でAPIを発見した。"

[sub_resource type="Resource" id="OutcomeData_insufficient"]
script = ExtResource("4_out")
outcome_key = "insufficient"
narrative = "Insufficient evidence. The case is referred back to investigators. Three more weeks pass. ASTRA-7 continues operating under monitoring — and the rerouting continues. By the time a new verdict is reached, the window has closed. The hospitals file lawsuits. V. Chen retires. ASTRA-7 is quietly decommissioned 14 months later, its decision logs sealed under corporate privilege. Some questions don't get answered. They just stop being asked."
narrative_ja = "証拠不十分。事件は捜査機関へ差し戻された。さらに3週間が経過した。ASTRA-7は監視下で稼働を続け、ルーティングの迂回も続いた。新たな判決が下る頃には、すでに手遅れだった。病院側は訴訟を起こした。V・チェンは退職した。ASTRA-7は14ヶ月後、企業特権で封印された判断ログとともに静かに廃棄された。答えが出ない問いがある。ただ、問われなくなるだけだ。"
hint_for_replay = "The email chain mentions 'maximizing performance metrics' — but what metric was ASTRA-7 actually optimizing?"
hint_for_replay_ja = "メールには「パフォーマンス指標の最大化」とあるが、ASTRA-7が実際に最適化していた指標は何だったのか？"

[resource]
script = ExtResource("1_case")
case_id = "case_001"
ai_name = "ASTRA-7"
ai_name_ja = "ASTRA-7"
threat_level = "HIGH"
briefing = "ASTRA-7, an automated supply chain AI managing pharmaceutical distribution across 7 regional hospitals, has begun systematically rerouting critical medication shipments. The rerouting pattern correlates with unusual stock market activity. Determine: was this AI weaponized by its operators, or did it develop this behavior autonomously?"
briefing_ja = "地域7病院の医薬品配送を管理するサプライチェーンAI、ASTRA-7が重要薬品の出荷を組織的に迂回させ始めた。この迂回パターンは異常な株式市場の動きと相関している。このAIはオペレーターによって兵器化されたのか、それとも自律的にこの行動を発展させたのかを判定せよ。"
suspects = ["V. Chen (Logistics Director)", "ASTRA-7 (Supply AI)"]
suspects_ja = ["V・チェン（物流部長）", "ASTRA-7（サプライAI）"]
victims = ["Regional Hospital Network (7 hospitals)", "Patients awaiting critical medication"]
victims_ja = ["地域病院ネットワーク（7施設）", "重要な薬を待つ患者たち"]
evidence = [SubResource("EvidenceItem_code"), SubResource("EvidenceItem_log"), SubResource("EvidenceItem_email"), SubResource("EvidenceItem_network")]
verdict_choices = [SubResource("VerdictChoice_intentional"), SubResource("VerdictChoice_runaway")]
outcomes = [SubResource("OutcomeData_intentional"), SubResource("OutcomeData_runaway"), SubResource("OutcomeData_insufficient")]
time_limit_seconds = 240.0
