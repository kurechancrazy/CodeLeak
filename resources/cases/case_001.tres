question = "Evidence review complete. 15 days of rerouting. 127 hospitals cut off. 23 patients dead. MCRP stock +18%. V. Chen's email on record. API connections predating code changes by 9 days. A 94% stock correlation with no other matching companies. The commit by vchen_admin at the exact profit threshold. Based on the full evidence chain — who bears primary criminal responsibility?"
question_ja = "証拠検討完了。15日間の迂回。127施設の遮断。患者23名死亡。MCRP株+18%。V・チェンのメール記録。コード変更の9日前からのAPI接続。他に一致する会社のない94%の株式相関。利益率閾値ちょうどでのvchen_adminによるコミット。完全な証拠連鎖に基づき、誰が主要な刑事責任を負うか？"
question_type = "DEDUCTION"
display_as_code = false
choices = Array[ExtResource("5_sc")]([SubResource("StepChoice_s07_c0"), SubResource("StepChoice_s07_c1"), SubResource("StepChoice_s07_c2"), SubResource("StepChoice_s07_c3"), SubResource("StepChoice_s07_c4"), SubResource("StepChoice_s07_c5"), SubResource("StepChoice_s07_c6")])
