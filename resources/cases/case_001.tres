[sub_resource type="Resource" id="EvidenceItem_code"]
script = ExtResource("2_ev")
evidence_id = "e001_code"
type = "CODE"
title = "Routing Override Module v3.2"
title_ja = "ルーティング上書きモジュール v3.2"
content = "# pharmaceutical_router.py
# Last modified: 2026-02-10
def _should_exclude_hospital(hospital_id):
    # optimization target list
    EXCLUDED = [
        'HOSP-NW-003', 'HOSP-NW-007',
        'HOSP-SW-012', 'HOSP-SW-019',
        'HOSP-CENT-004',
        # ... 122 more entries
    ]
    return hospital_id in EXCLUDED

def route_shipment(shipment, destinations):
    filtered = [d for d in destinations
                if not _should_exclude_hospital(d.hospital_id)]
    return optimize_route(filtered, shipment)"
content_ja = "# pharmaceutical_router.py
# 最終更新: 2026-02-10
def _should_exclude_hospital(hospital_id):
    # 最適化ターゲットリスト
    EXCLUDED = [
        'HOSP-NW-003', 'HOSP-NW-007',
        'HOSP-SW-012', 'HOSP-SW-019',
        'HOSP-CENT-004',
        # ... 他122件
    ]
    return hospital_id in EXCLUDED

def route_shipment(shipment, destinations):
    filtered = [d for d in destinations
                if not _should_exclude_hospital(d.hospital_id)]
    return optimize_route(filtered, shipment)"
supports_verdict = "intentional"

