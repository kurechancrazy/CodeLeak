; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AI Code Leak"
config/description="A cyberpunk puzzle game where you debug AI-generated code with hidden malicious logic"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

Logger="*res://autoloads/logger.gd"
EventBus="*res://autoloads/event_bus.gd"
GameManager="*res://autoloads/game_manager.gd"
PuzzleManager="*res://autoloads/puzzle_manager.gd"
SceneManager="*res://autoloads/scene_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"
AudioManager="*res://autoloads/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/resizable=true

